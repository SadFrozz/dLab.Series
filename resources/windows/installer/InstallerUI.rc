#include <windows.h>
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
201 BITMAP "assets/dLab-header.bmp"
105 DIALOGEX 0, 0, 460, 326
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "dLab plugins installer"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "",1037,"Static",SS_BITMAP,24,10,108,34
 LTEXT "Open-Source Audio Tools",1038,25,46,350,14
 CONTROL "",1018,"Static",SS_BLACKRECT | NOT WS_VISIBLE,24,72,412,185
 CONTROL "",1035,"Static",SS_ETCHEDHORZ,24,263,412,1
 CONTROL "",1028,"RichEdit20W",ES_READONLY | ES_AUTOHSCROLL,24,271,412,18
 PUSHBUTTON "Back",3,196,298,72,22
 DEFPUSHBUTTON "Next",1,274,298,78,22
 PUSHBUTTON "Cancel",2,358,298,78,22
END
106 DIALOGEX 0, 0, 412, 185
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 10, "Segoe UI"
BEGIN
 LTEXT "Installing your plug-ins",1006,0,8,412,22
 CONTROL "",1004,"msctls_progress32",WS_CHILD | WS_VISIBLE,0,45,412,14
 PUSHBUTTON "Details",1027,0,72,76,22
 CONTROL "",1016,"SysListView32",0x0001 | WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE,0,100,412,82
END
107 DIALOGEX 0, 0, 412, 185
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 10, "Segoe UI"
BEGIN
 LTEXT "Remove dLab.Series from this computer?",1006,0,0,412,36
 LTEXT "Installed in",1029,0,68,100,16
 EDITTEXT 1000,0,90,412,24,ES_READONLY | ES_AUTOHSCROLL
END
