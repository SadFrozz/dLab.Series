option(DLAB_BUILD_VST2 "Build separate ordinary VST2 effects for OBS" ON)
if(DLAB_BUILD_VST2)
 foreach(model IN ITEMS 286 376)
  add_library(dLab${model}_VST2 MODULE src/bundle/Vst2Bridge.cpp)
  target_link_libraries(dLab${model}_VST2 PRIVATE dLabSeries)
  target_include_directories(dLab${model}_VST2 PRIVATE "${JUCE_DIR}/modules")
  target_compile_definitions(dLab${model}_VST2 PRIVATE JUCE_GLOBAL_MODULE_SETTINGS_INCLUDED=1)
  target_compile_definitions(dLab${model}_VST2 PRIVATE DLAB_VST2_MODEL=${model})
  set_target_properties(dLab${model}_VST2 PROPERTIES PREFIX "" OUTPUT_NAME "dLab ${model}" LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/VST2/$<CONFIG>" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/VST2/$<CONFIG>")
  if(MSVC)
   target_compile_options(dLab${model}_VST2 PRIVATE /utf-8)
  endif()
  if(APPLE)
   set_target_properties(dLab${model}_VST2 PROPERTIES BUNDLE TRUE BUNDLE_EXTENSION vst MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/cmake/Vst2Info.plist.in" MACOSX_BUNDLE_GUI_IDENTIFIER "com.frozz.dlab.vst2.${model}" MACOSX_BUNDLE_BUNDLE_NAME "dLab ${model}" MACOSX_BUNDLE_BUNDLE_VERSION "1.0.0")
   add_custom_command(TARGET dLab${model}_VST2 POST_BUILD COMMAND /usr/bin/codesign --force --deep --sign - "$<TARGET_BUNDLE_DIR:dLab${model}_VST2>")
   add_custom_command(TARGET dLab_Series_Package POST_BUILD COMMAND ${CMAKE_COMMAND} -E make_directory "${DLAB_PACKAGE_DIR}/VST2" COMMAND ${CMAKE_COMMAND} -E copy_directory "$<TARGET_BUNDLE_DIR:dLab${model}_VST2>" "${DLAB_PACKAGE_DIR}/VST2/dLab ${model}.vst")
  else()
   add_custom_command(TARGET dLab_Series_Package POST_BUILD COMMAND ${CMAKE_COMMAND} -E make_directory "${DLAB_PACKAGE_DIR}/VST2" COMMAND ${CMAKE_COMMAND} -E copy "$<TARGET_FILE:dLab${model}_VST2>" "${DLAB_PACKAGE_DIR}/VST2/")
  endif()
  add_dependencies(dLab_Series_Package dLab${model}_VST2)
 endforeach()
endif()

