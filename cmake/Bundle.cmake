 COMMAND ${CMAKE_COMMAND} -E copy "${CMAKE_CURRENT_SOURCE_DIR}/README.md" "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE" "${CMAKE_CURRENT_SOURCE_DIR}/NOTICE.md" "${DLAB_PACKAGE_DIR}/"
 COMMAND ${CMAKE_COMMAND} -E copy "${JUCE_DIR}/LICENSE.md" "${DLAB_PACKAGE_DIR}/JUCE-LICENSE.md"
