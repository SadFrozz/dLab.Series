# Validate completed product paths; historical experiments remain opt-in in each module.
foreach(unit IN ITEMS DspTests CircuitTests PilotTests)
 add_executable(dlab_286_${unit} src/modules/Channel286/tests/${unit}.cpp)
 target_link_libraries(dlab_286_${unit} PRIVATE channel286_dsp)
 add_test(NAME dlab_286_${unit} COMMAND dlab_286_${unit})
endforeach()
foreach(unit IN ITEMS EngineChecks OversamplingChecks ReportedIssuesChecks SaturationTubeChecks ContractChecks)
 add_executable(dlab_376_${unit} src/modules/Channel376/tests/${unit}.cpp)
 target_include_directories(dlab_376_${unit} PRIVATE src/modules/Channel376/src)
 get_target_property(product_flags dLabSeries COMPILE_DEFINITIONS)
 target_compile_definitions(dlab_376_${unit} PRIVATE ${product_flags})
 if(MSVC)
  target_compile_options(dlab_376_${unit} PRIVATE /fp:precise /Ob3)
 else()
  target_compile_options(dlab_376_${unit} PRIVATE -fno-fast-math -ffp-contract=off)
 endif()
 add_test(NAME dlab_376_${unit} COMMAND dlab_376_${unit})
endforeach()
