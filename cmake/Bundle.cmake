find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(DLAB_GENERATED "${CMAKE_BINARY_DIR}/generated-wrappers")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/generate_wrappers.py" "${JUCE_DIR}" "${DLAB_GENERATED}" COMMAND_ERROR_IS_FATAL ANY)
set(bundle_formats VST3)
if(APPLE)
  list(APPEND bundle_formats AU)
endif()
juce_add_plugin(dLabSeries COMPANY_NAME "Frozz" BUNDLE_ID com.frozz.dlab.series
  PLUGIN_MANUFACTURER_CODE Frzz PLUGIN_CODE C286 PRODUCT_NAME "dLab.Series"
  VERSION 1.0.0 FORMATS ${bundle_formats} IS_SYNTH FALSE NEEDS_MIDI_INPUT FALSE
  NEEDS_MIDI_OUTPUT FALSE IS_MIDI_EFFECT FALSE COPY_PLUGIN_AFTER_BUILD FALSE)
target_sources(dLabSeries PRIVATE src/bundle/Processors.cpp
  src/modules/Channel286/src/PluginProcessor.cpp src/modules/Channel286/src/PluginEditor.cpp
  src/modules/Channel376/src/PluginProcessor.cpp src/modules/Channel376/src/PluginEditor.cpp)
target_include_directories(dLabSeries PUBLIC "${CMAKE_BINARY_DIR}/src/modules/Channel286/generated" "${CMAKE_CURRENT_SOURCE_DIR}/src/bundle")
target_link_libraries(dLabSeries PRIVATE channel286_dsp Channel286Fonts Channel376Fonts dLabBranding juce::juce_dsp juce::juce_audio_utils PUBLIC juce::juce_recommended_config_flags)
target_compile_definitions(dLabSeries PUBLIC DLAB_SUITE=1 JUCE_WEB_BROWSER=0 JUCE_USE_CURL=0 JUCE_VST3_CAN_REPLACE_VST2=0
  CHANNEL376_EXPERIMENTAL_TUBE_COLOUR=1 CHANNEL376_EXPERIMENTAL_MANIFOLD=1 CHANNEL376_EXPERIMENTAL_REDUCED_OUTPUT=1 CHANNEL376_EXPERIMENTAL_REDUCED_EQ=1 CHANNEL376_EXPERIMENTAL_DIODE_TABLE=1 CHANNEL376_EXPERIMENTAL_REDUCED_VCA=1 CHANNEL376_EXPERIMENTAL_COEFFICIENTS=1 CHANNEL376_EXPERIMENTAL_REDUCED_FRONT=1 CHANNEL376_EXPERIMENTAL_STEREO_VCA=1 CHANNEL376_PCM_OUTPUT_ONLY=1)
if(MSVC)
  target_compile_options(dLabSeries PRIVATE /utf-8 /fp:precise /Ob3)
else()
  target_compile_options(dLabSeries PRIVATE -fno-fast-math -ffp-contract=off "SHELL:-mllvm -inline-threshold=2000")
endif()
# Generate adapters from the pinned JUCE source; never modify the submodule.
set_source_files_properties("${JUCE_DIR}/modules/juce_audio_plugin_client/juce_audio_plugin_client_VST3.cpp" PROPERTIES HEADER_FILE_ONLY TRUE)
set_source_files_properties("${JUCE_DIR}/modules/juce_audio_plugin_client/juce_audio_plugin_client_VST3.mm" PROPERTIES HEADER_FILE_ONLY TRUE)
target_sources(dLabSeries_VST3 PRIVATE "${DLAB_GENERATED}/dLab_VST3.cpp")
if(APPLE)
  set_source_files_properties("${DLAB_GENERATED}/dLab_VST3.cpp" PROPERTIES LANGUAGE OBJCXX)
  set_source_files_properties("${JUCE_DIR}/modules/juce_audio_plugin_client/juce_audio_plugin_client_AU_1.mm" PROPERTIES HEADER_FILE_ONLY TRUE)
  target_sources(dLabSeries_AU PRIVATE "${DLAB_GENERATED}/dLab_AU_1.mm")
  add_custom_command(TARGET dLabSeries_AU POST_BUILD
    COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/cmake/register_au.py" "$<TARGET_BUNDLE_DIR:dLabSeries_AU>/Contents/Info.plist"
    COMMAND /usr/bin/codesign --force --deep --sign - "$<TARGET_BUNDLE_DIR:dLabSeries_AU>")
  add_custom_command(TARGET dLabSeries_VST3 POST_BUILD COMMAND /usr/bin/codesign --force --deep --sign - "$<TARGET_BUNDLE_DIR:dLabSeries_VST3>")
endif()
set(DLAB_PACKAGE_DIR "${CMAKE_BINARY_DIR}/Package/dLab.Series")
if(APPLE)
  add_custom_target(dLab_Series_Package
    COMMAND ${CMAKE_COMMAND} -E make_directory "${DLAB_PACKAGE_DIR}/VST3" "${DLAB_PACKAGE_DIR}/AU"
    COMMAND ${CMAKE_COMMAND} -E copy_directory "$<TARGET_BUNDLE_DIR:dLabSeries_VST3>" "${DLAB_PACKAGE_DIR}/VST3/dLab.Series.vst3"
    COMMAND ${CMAKE_COMMAND} -E copy_directory "$<TARGET_BUNDLE_DIR:dLabSeries_AU>" "${DLAB_PACKAGE_DIR}/AU/dLab.Series.component"
    DEPENDS dLabSeries_VST3 dLabSeries_AU)
else()
  add_custom_target(dLab_Series_Package
    COMMAND ${CMAKE_COMMAND} -E make_directory "${DLAB_PACKAGE_DIR}/VST3"
    COMMAND ${CMAKE_COMMAND} -E copy_directory "$<TARGET_FILE_DIR:dLabSeries_VST3>/../.." "${DLAB_PACKAGE_DIR}/VST3/dLab.Series.vst3"
    DEPENDS dLabSeries_VST3)
endif()

if(WIN32)
 add_custom_command(TARGET dLabSeries_VST3 POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/cmake/module_info.py" "$<TARGET_FILE_DIR:dLabSeries_VST3>/../Resources/moduleinfo.json")
else()
 add_custom_command(TARGET dLabSeries_VST3 POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/cmake/module_info.py" "$<TARGET_BUNDLE_DIR:dLabSeries_VST3>/Contents/Resources/moduleinfo.json" COMMAND /usr/bin/codesign --force --deep --sign - "$<TARGET_BUNDLE_DIR:dLabSeries_VST3>")
